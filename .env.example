# PostgreSQL (docker-compose)
POSTGRES_USER=smartwork
POSTGRES_PASSWORD=smartwork_secret
POSTGRES_DB=smartwork

# Backend (используется в API; для docker-compose хост — имя сервиса db)
DATABASE_URL=postgresql+asyncpg://smartwork:smartwork_secret@db:5432/smartwork

# Redis (в Docker хост — redis)
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# MailHog / SMTP
MAILHOG_WEB_PORT=8025
MAILHOG_SMTP_PORT=1025
SMTP_HOST=mail
SMTP_PORT=1025
EMAIL_FROM=SmartWork <no-reply@smartwork.local>

# JWT (смените в продакшене)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS (для локальной разработки без Docker укажите http://localhost:4200)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:80

# API
API_V1_PREFIX=/api/v1

# Dev seed staff user (disabled by default)
ENABLE_DEV_SEED_STAFF=false
DEV_SEED_STAFF_LOGIN=superworker@smartwork.local
DEV_SEED_STAFF_PASSWORD=
